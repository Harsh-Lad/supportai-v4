# MongoDB connection string (use free MongoDB Atlas cluster)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/supportai?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# ── REQUIRED: OpenAI API Key ──
# Used for: embeddings (text-embedding-3-small) + default AI responses (gpt-4o-mini)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# ── Optional: Override the default chat model used when no tenant BYOK is configured ──
# Defaults to gpt-4o-mini when unset.
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# ── Optional: Encryption key for API key storage ──
ENCRYPTION_KEY=generate-with-openssl-rand-base64-32

# ── Optional: SMTP for emails (password reset, invites, notifications) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SupportAI <noreply@supportai.app>

# ── Optional: Razorpay billing ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_ENTERPRISE_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
